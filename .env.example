# Public, non-secret settings. Copy these lines into the .env generated by
# scripts/setup-local.sh (do not overwrite existing database passwords).
# Local defaults:
TOQ_BIND_ADDRESS=127.0.0.1
TOQ_PUBLIC_FRONTEND_URL=http://localhost:8080
TOQ_PUBLIC_KEYCLOAK_URL=http://localhost:8081

# Proxmox direct-IP HTTPS: use compose.https.yaml and trust its public CA
# on each PC (see docs/PROXMOX.md). Keep existing secrets in your .env.
# TOQ_BIND_ADDRESS=172.16.10.20
# TOQ_PUBLIC_FRONTEND_URL=https://172.16.10.20:8080
# TOQ_PUBLIC_KEYCLOAK_URL=https://172.16.10.20:8081

# Never put database passwords, admin credentials or API keys in this example.
